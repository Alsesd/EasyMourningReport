# Copy to ".env" next to the program (legkyi.exe / legkyi). Every line is optional.
# Variables already set in the environment win over this file.

# ── First start ──────────────────────────────────────────────────────────────
# Administrator password for the FIRST start only (otherwise a random one is printed once in the console).
#ADMIN_PASSWORD=choose-a-password
# 1 adds demo stores, products and transport orders when the database is created.
#DEMO=0

# ── Server ───────────────────────────────────────────────────────────────────
# Listen address.
#HOST=127.0.0.1
#PORT=8000
# 1 marks the session cookie Secure (use only when the app is reached through https).
#COOKIE_SECURE=0
# Fixed session-signing secret (default: generated into secret.key).
#SECRET_KEY=
# Reverse proxies allowed to set X-Forwarded-For (default 127.0.0.1 = the local cloudflared).
#FORWARDED_ALLOW_IPS=127.0.0.1

# ── Data and backups ─────────────────────────────────────────────────────────
# Move data / backups away from the program's folder.
#LEGKYI_DATA_DIR=
#LEGKYI_BACKUPS_DIR=
# wal | delete | auto
#SQLITE_JOURNAL_MODE=auto
# Backups: how often (minutes) and how many to keep.
#BACKUP_EVERY_MIN=60
#BACKUP_KEEP=100

# ── Public access (Cloudflare Tunnel) ────────────────────────────────────────
# Cloudflare named-tunnel token: a stable public address. Without it a temporary trycloudflare.com tunnel is used.
#TUNNEL_TOKEN=
# Address shown on the admin page for a named tunnel.
#PUBLIC_URL=https://zvit.example.com
# 0 keeps the tunnel off at start-up (the single-file build turns it on at the first start).
#TUNNEL_ENABLED=1
# Use another cloudflared instead of the bundled one.
#CLOUDFLARED_PATH=

# ── Sign-in ──────────────────────────────────────────────────────────────────
# Biometric (passkey) sign-in is bound to the host name. Pin it when the app answers on several names
# (a quick tunnel gets a new name on every start, so passkeys need a named tunnel).
#PASSKEY_RP_ID=
# Cloudflare Access (e-mail one-time PIN at the edge). Needs a named tunnel on your own domain; both values
# switch it on for requests that come through the tunnel (see docs/security.md).
#CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
#CF_ACCESS_AUD=

# ── Updates (release builds only) ────────────────────────────────────────────
# The program checks GitHub for a newer release and installs it by itself. 0 = only the admin page's button.
#AUTO_UPDATE=1
# How often to check, in hours.
#AUTO_UPDATE_CHECK_HOURS=6
# Another GitHub repository (owner/name) to take releases from.
#UPDATE_REPO=alsesd/easymourningreport
# For tests only: a fake GitHub API on this machine, e.g. http://127.0.0.1:8898
#UPDATE_API_URL=
