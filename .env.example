# ── EasyMourningReport / Легкий Звіт ─────────────────────────────

# Never generate __pycache__/*.pyc artifacts, including inside containers.
PYTHONDONTWRITEBYTECODE=1
# Copy this file to .env and customize values if desired.
# First run on a fresh host: ./docker/ops/init.sh
# It creates the external PostgreSQL volume, then runs `docker compose up -d`.

# Web port exposed on the host machine (0.0.0.0 binding for Windows 11 & Linux)
PORT=8000

# Persistent storage paths on host device (automatically created)
# Windows 11 Note: Use relative paths (./data) or forward slashes (e.g. C:/EasyMourningReport/data)
DATA_PATH=./data
BACKUPS_PATH=./backups
# Independent mirror of the SQL backups. Put this on another physical drive.
BACKUPS_MIRROR_PATH=./backups-mirror

# Keep the PostgreSQL data in an external Docker volume so `docker compose down -v`
# cannot delete it. `docker/ops/init.sh` creates this volume when missing.
PGDATA_VOLUME=easymourningreport_pgdata

# Automatic SQL backup policy (snapshots kept per destination / minutes between runs)
BACKUP_KEEP=100
BACKUP_EVERY_MIN=60

# App security & initial configuration (optional)
# SECRET_KEY=         # Override auto-generated session encryption key
# ADMIN_PASSWORD=     # Set admin password on first boot (otherwise generated randomly)
# DEMO=1              # Seed demo products, stores, and reports on first boot
# PUBLIC_URL=         # Custom public URL / reverse proxy endpoint (e.g. https://report.example.com)

# ── PostgreSQL (Docker Compose) ──────────────────────────────────────
# Used by the bundled db service. Override for an external PostgreSQL.
POSTGRES_DB=mourningreport
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/mourningreport

# ── Cloudflare Tunnel (optional, runs internally in app container) ──
# TUNNEL_ENABLED=true # Enable internal Cloudflare tunnel on startup
# TUNNEL_TOKEN=       # Custom Cloudflare Tunnel token (e.g. eyJh...) for named tunnel
