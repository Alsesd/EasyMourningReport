# ── EasyMourningReport / Легкий Звіт ─────────────────────────────
# Copy this file to .env and customize values if desired.
# By default, running 'docker compose up' works out of the box with zero flags!

# Web port exposed on the host machine (Linux and Windows)
PORT=8000

# Persistent storage paths on host device (automatically created)
DATA_PATH=./data
BACKUPS_PATH=./backups

# App security & initial configuration (optional)
# SECRET_KEY=         # Override auto-generated session encryption key
# ADMIN_PASSWORD=     # Set admin password on first boot (otherwise generated randomly)
# DEMO=1              # Seed demo products, stores, and reports on first boot
# PUBLIC_URL=         # Custom domain URL if using external reverse proxy

# ── Cloudflare Tunnel (optional) ──────────────────────────────────
# Quick Tunnel is enabled automatically when no token is provided.
# TUNNEL_ENABLED=true # Set to false to disable public tunnel sidecar
# TUNNEL_TOKEN=       # Custom Cloudflare Tunnel token (e.g. eyJh...)
# PUBLIC_URL=         # Custom domain if using a named tunnel (e.g. https://report.example.com)
