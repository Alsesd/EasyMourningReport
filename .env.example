# ── EasyMourningReport / Легкий Звіт ─────────────────────────────
# Copy this file to .env and customize values if desired.
# By default, running 'docker compose up' works out of the box with zero flags!

# Web port exposed on the host
PORT=8000

# App settings (optional)
# SECRET_KEY=         # Override auto-generated session key
# ADMIN_PASSWORD=     # Set admin password on first boot (otherwise generated randomly)
# DEMO=1              # Seed demo data on first boot

# ── Cloudflare Tunnel (optional) ──────────────────────────────────
# By default, a free TryCloudflare Quick Tunnel is launched automatically.
# To connect your own named Cloudflare Tunnel with a custom domain, set your token:
# TUNNEL_TOKEN=
# CLOUDFLARE_TUNNEL_TOKEN=
# PUBLIC_URL=https://your-domain.example.com

# Set to false to disable the tunnel container entirely
# TUNNEL_ENABLED=true
