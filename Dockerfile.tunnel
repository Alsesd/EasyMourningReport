# Reuse the official Cloudflare binary in a small Debian image with a shell.
FROM cloudflare/cloudflared:latest AS cloudflared

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates coreutils grep \
    && rm -rf /var/lib/apt/lists/*
COPY --from=cloudflared /usr/local/bin/cloudflared /usr/local/bin/cloudflared
COPY tunnel-entrypoint.sh /usr/local/bin/tunnel-entrypoint.sh
RUN chmod 0755 /usr/local/bin/tunnel-entrypoint.sh

ENV TUNNEL_TARGET_URL=http://127.0.0.1:8000

ENTRYPOINT ["/bin/sh", "/usr/local/bin/tunnel-entrypoint.sh"]
